#include <stdio.h>

int main() {
    int a[50], n, i;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    if (n >= 5)
        printf("5th element = %d", a[4]);
    else
        printf("Less than 5 elements");

    return 0;
}
