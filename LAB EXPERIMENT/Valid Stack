#include <stdio.h>

#define MAX 5

int stack[MAX], top = -1;

void push(int x) {
    if (top == MAX - 1)
        printf("Stack Overflow\n");
    else
        stack[++top] = x;
}

void pop() {
    if (top == -1)
        printf("Stack Underflow\n");
    else
        printf("Deleted: %d\n", stack[top--]);
}

void display() {
    int i;

    if (top == -1) {
        printf("Stack is Empty");
        return;
    }

    printf("Stack: ");
    for (i = top; i >= 0; i--)
        printf("%d ", stack[i]);
}

int main() {
    int choice, x;

    while (1) {
        printf("\n1.Push  2.Pop  3.Display  4.Exit\n");
        scanf("%d", &choice);

        if (choice == 1) {
            scanf("%d", &x);
            push(x);
        }
        else if (choice == 2)
            pop();
        else if (choice == 3)
            display();
        else
            break;
    }

    return 0;
}
