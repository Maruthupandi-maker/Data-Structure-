#include <stdio.h>

int main() {
    int a[50], b[50], c[100];
    int n, m, i;

    printf("Enter size of list 1: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter size of list 2: ");
    scanf("%d", &m);

    for (i = 0; i < m; i++)
        scanf("%d", &b[i]);

    for (i = 0; i < n; i++)
        c[i] = a[i];

    for (i = 0; i < m; i++)
        c[n + i] = b[i];

    printf("Merged List: ");
    for (i = 0; i < n + m; i++)
        printf("%d ", c[i]);

    return 0;
}
