#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int i, valid = 1;

    printf("Enter a string: ");
    scanf("%s", str);

    for (i = 0; i < strlen(str); i++) {
        if (!((str[i] >= 'a' && str[i] <= 'z') ||
              (str[i] >= 'A' && str[i] <= 'Z') ||
              (str[i] >= '0' && str[i] <= '9'))) {
            valid = 0;
            break;
        }
    }

    if (valid)
        printf("Valid String");
    else
        printf("Invalid String");

    return 0;
}
