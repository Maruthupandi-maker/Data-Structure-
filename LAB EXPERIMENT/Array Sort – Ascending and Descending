#include <stdio.h>

int main() {
    int a[50], n, i, j, temp;

    printf("Enter size: ");
    scanf("%d", &n);

    printf("Enter array: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    for (i = 0; i < n - 1; i++)
        for (j = i + 1; j < n; j++)
            if (a[i] > a[j]) {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }

    printf("Ascending: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    printf("\nDescending: ");
    for (i = n - 1; i >= 0; i--)
        printf("%d ", a[i]);

    return 0;
}
