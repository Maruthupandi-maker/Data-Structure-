#include <stdio.h>

int main() {
    int a[50], n, key, i, found = 0;

    printf("Enter size: ");
    scanf("%d", &n);

    printf("Enter array: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter element: ");
    scanf("%d", &key);

    for (i = 0; i < n; i++) {
        if (a[i] == key) {
            printf("Element found at position %d", i + 1);
            found = 1;
            break;
        }
    }

    if (!found)
        printf("Element not found");

    return 0;
}
