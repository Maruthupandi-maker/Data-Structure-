#include <stdio.h>

int main() {
    int a[50], n, key, i, low, high, mid;
    int found = 0;

    printf("Enter size: ");
    scanf("%d", &n);

    printf("Enter sorted array: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter element: ");
    scanf("%d", &key);

    /* Linear Search */
    for (i = 0; i < n; i++) {
        if (a[i] == key) {
            printf("Linear Search: Found\n");
            found = 1;
            break;
        }
    }

    if (!found)
        printf("Linear Search: Not Found\n");

    /* Binary Search */
    low = 0;
    high = n - 1;
    found = 0;

    while (low <= high) {
        mid = (low + high) / 2;

        if (a[mid] == key) {
            found = 1;
            break;
        }
        else if (key < a[mid])
            high = mid - 1;
        else
            low = mid + 1;
    }

    if (found)
        printf("Binary Search: Found");
    else
        printf("Binary Search: Not Found");

    return 0;
}
