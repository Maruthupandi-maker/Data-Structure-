#include <stdio.h>

int main() {
    int a[50], n, i, sum = 0, total;

    printf("Enter n: ");
    scanf("%d", &n);

    printf("Enter %d-1 elements: ", n);

    for (i = 0; i < n - 1; i++) {
        scanf("%d", &a[i]);
        sum += a[i];
    }

    total = n * (n + 1) / 2;

    printf("Missing element = %d", total - sum);

    return 0;
}
