#include <stdio.h>

int main() {
    int reg[50], n, key, i, found = 0;

    printf("Enter number of students: ");
    scanf("%d", &n);

    printf("Enter register numbers: ");
    for (i = 0; i < n; i++)
        scanf("%d", &reg[i]);

    printf("Enter register number to search: ");
    scanf("%d", &key);

    for (i = 0; i < n; i++) {
        if (reg[i] == key) {
            found = 1;
            break;
        }
    }

    if (found)
        printf("Register number found");
    else
        printf("Register number not found");

    return 0;
}
